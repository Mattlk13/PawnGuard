{
  "name": "pawnguard-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.jsonc",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --config ../wrangler.jsonc",
    "deploy": "node scripts/deploy.mjs",
    "provision:access": "node scripts/provision-access.mjs"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "miniflare": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
